# Run tests — required to clone and run Playwright

# App under test; Playwright baseURL (BuddyTime test site).
APP_URL=https://your-buddytime-test-host.example/app

# Main test family's account; used by auth.setup.
APP_USER_EMAIL=your-main-user@example.com

# Password for APP_USER_EMAIL.
APP_USER_PASSWORD=your-main-password

# Second family's account; for flows that need two parents (tests skip if unset).
APP_ALT_USER_EMAIL=your-alt-user@example.com

# Password for APP_ALT_USER_EMAIL.
APP_ALT_USER_PASSWORD=your-alt-password

# Agent / CI setup — not needed for npx playwright test alone

# Cursor headless agent in .github/workflows/test-generation.yml.
CURSOR_API_KEY=your-cursor-api-key

# Atlassian site URL.
ATLASSIAN_BASE_URL=https://your-site.atlassian.net

# Atlassian account email paired with the token.
ATLASSIAN_EMAIL=your-atlassian-account@example.com

# Atlassian API token for backlog queries and labels.
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Jira project for stories and bugs (AQPBT).
JIRA_PROJECT_KEY=AQPBT

# Confluence space for feature pages (AQPBT).
CONFLUENCE_SPACE_KEY=AQPBT
